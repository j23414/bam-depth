params {
  help = false

  // Output directory
  outdir = './depth-results'

  // Either input reads as a samplesheet (csv) with headings "sample","bam" or a glob pattern
  samplesheet = false
  bam = false

  // Get top hit on gene coverage for the segments, segment names must be in reference header
  segments = 'HA NA PB2 PB1 PA NP MP NS'

  // Allow depth to complete for valid samples even if one or more samples fail
  error_strategy='ignore' // 'ignore' or 'terminate'

  plot_depth_script=false
}

profiles {
  local { }
  stjude {
    includeConfig 'configs/stjude.config'
  }
}

process {
  publishDir = [ path: "${params.outdir}", mode: 'copy']
  errorStrategy = params.error_strategy
  withName: 'SAMTOOLS_INDEX' { 
    publishDir = [ path: "${params.outdir}/samtools_index", mode: 'copy'] }
  withName: 'SAMTOOLS_DEPTH' {
    publishDir = [ path: "${params.outdir}/samtools_depth", mode: 'copy']
    ext.args = ' -aa ' // (-aa) Output all positions (even zero depth)
    }
  withName: 'SAMTOOLS_COVERAGE' {
    publishDir = [ path: "${params.outdir}/samtools_coverage", mode: 'copy']
  }
  withName: 'PLOT_DEPTH' {
    //module = "R/4.4.0"
    publishDir = [ path: "${params.outdir}/plot_depth", mode: 'copy']
  }
}

trace {
    enabled = true
    file = "$params.outdir/trace.txt"
}

manifest {
    name = 'j23414/bam-depth'
    description = "A modular workflow for generating depth and coverage statistics for alignment files pre and post filtering."
    version = "0.0"
    mainScript = 'main.nf'
}